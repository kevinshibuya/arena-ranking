# Every variable is optional locally: the defaults below match compose.dev.yaml
# and the real upstreams. Nothing loads this file automatically; export what you
# change, or let the production compose file set it.

# Postgres and Redis
DATABASE_URL=postgres://arena:arena@localhost:54329/arena
REDIS_URL=redis://localhost:63799
# Prefix for every Redis key, BullMQ's included
REDIS_PREFIX=arena

# Riot key: a file re-read on every request, or the key itself while the file is unset, missing or empty
RIOT_KEY_FILE=
RIOT_API_KEY=

# Upstream base URLs (tests and the smoke point these at the fake upstream)
RIOT_API_BASE_AMERICAS=https://americas.api.riotgames.com
RIOT_API_BASE_BR1=https://br1.api.riotgames.com
DDRAGON_BASE=https://ddragon.leagueoflegends.com
CDRAGON_BASE=https://raw.communitydragon.org

# Riot key limits
RIOT_RATE_PER_SECOND=20
RIOT_RATE_PER_TWO_MINUTES=100
# While the key is rejected, how often the key file is tried again
RIOT_KEY_PROBE_INTERVAL_MS=60000

# Queue ids every Arena listing runs once per; Riot uses ids it does not publish
ARENA_QUEUE_IDS=1700,1710,1740,1750

# Ladder
LADDER_MIN_GAMES=10

# Sweep: syncs every player with a match ended in this many hours
SWEEP_LOOKBACK_HOURS=168

# Update now: peers whose X-Forwarded-For names the client; behind Caddy and the web container: loopback,uniquelocal
TRUSTED_PROXIES=loopback

# Processes
PORT=3001
API_INTERNAL_URL=http://localhost:3001
LOG_LEVEL=info

# Queue dashboard basic auth; the dashboard is off while either is empty
DASHBOARD_USER=
DASHBOARD_PASS=
