# arena-ranking on the box. Copy to ~/apps/arena-ranking/.env, chmod 600, and fill by hand.
# Compose interpolates these into each container's environment; nothing loads the file
# into a container whole. Random values: `openssl rand -hex 32` (hex is safe inside URLs).

# Written by bin/deploy.sh and bin/rollback.sh; leave both empty before the first deploy.
IMAGE_TAG=
PREVIOUS_IMAGE_TAG=

# Owner of riot.key (`id -u`, `id -g` on the box); api and worker run as this user.
APP_UID=
APP_GID=

POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Queue dashboard basic auth, reached through the SSH tunnel; off while either is empty.
DASHBOARD_USER=
DASHBOARD_PASS=

# Loopback port of the API on the box, for the SSH tunnel.
API_TUNNEL_PORT=3301

# Riot key limits and the Arena queue ids (README, "Environment variables").
RIOT_RATE_PER_SECOND=20
RIOT_RATE_PER_TWO_MINUTES=100
ARENA_QUEUE_IDS=1700,1710,1740,1750
LADDER_MIN_GAMES=10
LOG_LEVEL=info

# Cloudflare R2, for bin/backup.sh and bin/restore.sh.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=arena-ranking-backups
