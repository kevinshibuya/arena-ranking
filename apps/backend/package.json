    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "bullmq": "^6.3.11",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "openskill": "^5.0.1",
    "pg": "^8.23.1",
